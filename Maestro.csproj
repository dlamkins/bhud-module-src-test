<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Maestro</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>Preview</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Maestro\Data.songs.bin" />
    <EmbeddedResource Include="Maestro\Data.songs.bin" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Blish HUD">
      <HintPath>..\..\working\Blish HUD.exe</HintPath>
    </Reference>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="MonoGame.Framework" />
    <Reference Include="System.Core" />
    <Reference Include="Newtonsoft.Json" />
    <Reference Include="MessagePack">
      <HintPath>..\..\working\MessagePack.dll</HintPath>
    </Reference>
    <Reference Include="MessagePack.Annotations">
      <HintPath>..\..\working\MessagePack.Annotations.dll</HintPath>
    </Reference>
    <Reference Include="MonoGame.Extended" />
  </ItemGroup>
</Project>